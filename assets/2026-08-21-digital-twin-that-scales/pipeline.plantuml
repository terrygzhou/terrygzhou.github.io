' Data pipeline: sourcing, processing, storage, consumption, heartbeat feedback,
' and self-maintenance jobs. Narrow layout for mobile.
@startuml
skinparam defaultFontSize 13
skinparam roundCorner 8

top to bottom direction

together {
    rectangle "**SOURCING**" as src1 #FFFFFF
    rectangle "Telegram · social · papers · GitHub" as src2 <<application-component>>
    rectangle "VS Code · Obsidian · emails · cron" as src3 <<application-component>>
    rectangle "manual · Apple Notes · PDFs · web" as src4 <<application-component>>
    src1 -[hidden]down- src2
    src2 -[hidden]down- src3
    src3 -[hidden]down- src4
}

together {
    rectangle "**PROCESSING**" as proc1 #FFFFFF
    rectangle "dedupe" as p1 <<process>>
    rectangle "chunk" as p2 <<process>>
    rectangle "embed (CPU)" as p3 <<process>>
    rectangle "LLM extract\nentities + relations" as p4 <<application-service>>
    proc1 -[hidden]down- p1
    p1 -[hidden]down- p2
    p2 -[hidden]down- p3
    p3 -[hidden]down- p4
}

together {
    rectangle "**STORAGE**" as store1 #FFFFFF
    rectangle "Qdrant (vectors) + Neo4j (graph)" as db <<data-store>> #E8F0FE
    store1 -[hidden]down- db
}

together {
    rectangle "**CONSUMPTION**" as cons1 #FFFFFF
    rectangle "agent session" as c2 <<application-component>>
    rectangle "Mem0" as c3 <<application-service>>
    rectangle "answer" as c4
    cons1 -[hidden]down- c2
    c2 -[hidden]down- c3
    c3 -[hidden]down- c4
}

src4 -down-> proc1 : everything flows in
p4 -down-> store1 : stored
db -down-> c2 : retrieved

together {
    rectangle "HEARTBEAT — outputs, corrections, decisions" as fb #FCE7F3
}
c4 -down-> fb : every conversation feeds back in

together {
    rectangle "SELF-MAINTENANCE — schedule + maintain" as jobs #F3E8FF
}
fb -down-> jobs
jobs .down.> db : maintain
@enduml
