vars: {
  layout-engine: elk
  d2-config: { theme-id: 100 }
}
direction: right

# --- main forward pipeline (left → right) ---

sources: {
  label: "SOURCING"
  style: {
    fill: "#f1f5f9"
    stroke: "#64748b"
    stroke-width: 2
    border-radius: 8
    font-size: 15
  }
  channels: {
    label: "Telegram · social · papers · GitHub\nVS Code · Obsidian · emails · cron\nmanual · Apple Notes · PDFs · web"
    style: { font-size: 11; fill: "#fff" }
  }
}

processing: {
  label: "PROCESSING"
  style: {
    fill: "#fef9c3"
    stroke: "#ca8a04"
    stroke-width: 2
    border-radius: 8
    font-size: 15
  }
  dedup:   { label: "dedupe" }
  chunk:   { label: "chunk" }
  embed:   { label: "embed\n(CPU)" }
  extract: { label: "LLM extract\nentities + relations" }
  dedup -> chunk -> embed -> extract
}

stores: {
  label: "STORAGE"
  style: {
    fill: "#dbeafe"
    stroke: "#3b82f6"
    stroke-width: 2
    border-radius: 8
    font-size: 15
  }
  store: {
    label: "Qdrant (vectors)\n+ Neo4j (graph)"
    shape: cylinder
  }
}

consumption: {
  label: "CONSUMPTION"
  style: {
    fill: "#dcfce7"
    stroke: "#16a34a"
    stroke-width: 2
    border-radius: 8
    font-size: 15
  }
  agent:  { label: "agent session"; shape: person }
  mem0:   { label: "Mem0" }
  answer: { label: "answer" }
  agent -> mem0: "query"
  mem0 -> answer
}

# --- feedback + maintenance (below the main row) ---

heartbeat: {
  label: "HEARTBEAT"
  subtitle: "outputs · corrections · decisions"
  style: {
    fill: "#fce7f3"
    stroke: "#ec4899"
    stroke-width: 3
    border-radius: 8
    font-size: 14
    font-color: "#831843"
  }
}

jobs: {
  label: "SELF-MAINTENANCE"
  subtitle: "ingest · consolidate · prune · backfill"
  style: {
    fill: "#f3e8ff"
    stroke: "#8b5cf6"
    stroke-width: 2
    border-radius: 8
    font-size: 14
  }
}

# forward flow
sources -> processing
processing.extract -> stores.store
stores.store -> consumption.mem0

# heartbeat loop
consumption.answer -> heartbeat
heartbeat -> sources

# self-maintenance (dashed, quiet)
jobs -> stores.store: { style: { stroke-dash: 4 } }
jobs -> sources: { style: { stroke-dash: 4 } }
