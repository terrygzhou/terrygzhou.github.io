' Four-phase evolution of the digital twin
' Phase 1 (snapshot) -> Phase 2 (memory) -> Phase 3 (learning) -> Phase 4 (understanding)
@startuml
skinparam archimate {
    roundCorner 8
}
skinparam defaultFontSize 13

top to bottom direction

package "PHASE 1 — STATIC SNAPSHOT" as p1 {
    rectangle "AnythingLLM / OpenNotebook / llm_wiki" as p1snap <<application-component>>
    rectangle "structure demanded before value; no merge path" as p1prob #FFE8E8
    p1snap -down-> p1prob : dead end
}

package "PHASE 2 — MEMORY" as p2 {
    rectangle "notes, emails, docs, chats, PDFs, URLs" as p2src
    rectangle "Qdrant: one collection, one source of truth" as p2q <<data-store>> #E8F0FE
    rectangle "retrieval floods the context window" as p2ov #FFE8E8
    p2src -down-> p2q : chunk + embed
    p2q -down-> p2ov : too much recalled
}

package "PHASE 3 — LEARNING" as p3 {
    rectangle "agent sessions" as p3a <<application-component>>
    rectangle "Mem0 adaptive memory layer" as p3m <<application-service>>
    rectangle "Qdrant collection (dynamic)" as p3c <<data-store>> #E8F0FE
    p3a -right-> p3m : ask
    p3m -right-> p3c : selective retrieval
    p3m -left-> p3a : only what matters, now
}

package "PHASE 4 — UNDERSTANDING" as p4 {
    rectangle "local LLM (GPU)" as p4brain <<technology-system-software>> #E8F0FE
    rectangle "Qdrant: 344K chunks" as p4q <<data-store>> #E8F0FE
    rectangle "Neo4j: 18.5K entities, 75K relationships" as p4neo <<data-store>> #E8F0FE
    rectangle "custom GraphRAG extraction" as p4g <<application-service>>
    rectangle "recall + context woven into one answer" as p4ans #FFE8E8
    p4brain -right-> p4g : batch extraction
    p4g -right-> p4neo : entities + relationships
    p4q -right-> p4ans : vector search
    p4neo -right-> p4ans : graph traversal
}

p1 -down-> p2 : solved: single source of truth
p2 -down-> p3 : solved: context-aware recall
p3 -down-> p4 : solved: from chunks to a connected story
@enduml
